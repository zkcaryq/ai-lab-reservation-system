# 复制为 .env；空的必填项必须由你填写。不要复制学习项目的数据库配置。
APP_NAME=FastAPI Backend
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# 允许访问后端的前端源，格式必须是 JSON 数组。
# 跨电脑调试时，把前端电脑的实际地址加入数组，例如 http://192.168.1.10:5173。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 当前 JWT 使用 Authorization 请求头，不使用跨站 Cookie，所以保持 false。
CORS_ALLOW_CREDENTIALS=false

# JWT签名配置。真实密钥只写在本地.env或生产Secret中。
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=48

# AI 供应商配置（数据库中保存的 API Key）加密密钥。
# 建议与 JWT_SECRET_KEY 不同；为空时回退到 JWT_SECRET_KEY（旧数据兼容）。
# 轮换 JWT_SECRET_KEY 后，所有数据库中保存的 AI Key 将无法解密，
# 因此强烈建议首次部署就显式配置该项，使两类密钥生命周期独立。
# AI_CONFIG_ENCRYPTION_KEY=

# 运行时 DB 账号：理论上只需 SELECT / INSERT / UPDATE / DELETE。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# 必填：填写你已经创建并获得权限的 Schema；模板不负责创建数据库或 Schema。
DB_SCHEMA=app

# 迁移账号（可选）：拥有 CREATE / ALTER / DROP 等 DDL 权限。
# 留空时 Alembic 会回退到上面的运行时账号（开发环境常用）。
# 生产环境建议独立配置：迁移账号不应被应用长期持有。
# MIGRATION_DB_USER=
# MIGRATION_DB_PASSWORD=

# 按 PostgreSQL/RDS 的实际 TLS 设置配置；生产推荐 verify-full 并配置 CA 路径。
DB_SSLMODE=prefer
# DB_SSLROOTCERT=D:/certs/database-ca.pem
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=60000

HEALTH_TIMEOUT=5
SHUTDOWN_TIMEOUT=10

# 预约审核：超过15分钟仍待审核且预约尚未开始时自动通过；每60秒扫描一次。
RESERVATION_AUTO_APPROVE_MINUTES=15
RESERVATION_REVIEW_SCAN_SECONDS=60

# 文件上传：默认5 MiB头像；整个multipart请求预留约1 MiB协议开销。
MAX_UPLOAD_FILE_BYTES=5242880
ALLOWED_UPLOAD_EXTENSIONS=[".jpg",".jpeg",".png",".webp",".gif"]
# 不填写UPLOAD_DIR时使用backend/uploads；生产可覆盖为持久化磁盘绝对路径。
# UPLOAD_DIR=D:/data/ai-lab/uploads

# ===================== AI 供应商配置 =====================
# 重要：AI 供应商/模型相关的 provider、model、base_url、api_key、思考深度、超时，
# 已完全改为由管理员在【AI供应商配置管理页】前端配置（存数据库、即时生效），
# 不再写入 .env。首次部署后需管理员登录配置页填写各能力的供应商信息，AI 才可用。

# 聊天回答输出 Token 上限（含思考 Token）。曾用1024导致长回答被截断，现默认4096。
# 这是上限，实际计费按生成量，不因调高而增加固定成本。
BAILIAN_CHAT_MAX_OUTPUT_TOKENS=4096

# 融合向量维度（数据库 vector(1024) 列绑定，固定 1024，不可改）。
# 修改会导致数据库列不匹配、检索失效，需迁移并重算全部向量。
BAILIAN_EMBEDDING_DIMENSION=1024

# ===================== 知识库与文档处理（基础设施）=====================
# 知识库私有存储目录，不通过 StaticFiles 公开；相对路径固定解析到 backend 根目录。
KNOWLEDGE_STORAGE_DIR=storage/knowledge
# 知识文档上传上限（20 MiB）；整个 multipart 请求上限必须大于所有单文件上限。
MAX_KNOWLEDGE_FILE_BYTES=20971520
MAX_REQUEST_BODY_BYTES=23068672
# AI 以图检索单张查询图片上限（10 MiB）。
MAX_AI_QUERY_IMAGE_BYTES=10485760
# 后台 Worker 轮询间隔（秒）；处理中的文档是否由 Web 进程内 Worker 领取。
KNOWLEDGE_WORKER_SCAN_SECONDS=2
KNOWLEDGE_WORKER_ENABLED=true
# 单份文档从解析到入库的总时限（秒）；超时标记 failed。运行期间按
# KNOWLEDGE_STALE_RECHECK_SECONDS 空闲轮询恢复中断的孤儿任务。
KNOWLEDGE_TASK_TIMEOUT_SECONDS=1800
KNOWLEDGE_STALE_RECHECK_SECONDS=60
# 解析规模限制（防资源耗尽，与上传大小上限互补）。
KNOWLEDGE_MAX_PAGES=200
KNOWLEDGE_MAX_IMAGES=100
KNOWLEDGE_MAX_CHUNKS=2000
KNOWLEDGE_MAX_TEXT_CHARS=2000000
# 向量召回先取多少候选，再由 rerank 精排成最终 Top K。
RAG_CANDIDATE_LIMIT=20
